#--------------------------------------------------------------------------
# KN Bazar - Digital Product Marketplace
# Copy to .env, then run: php artisan key:generate
# Most marketplace options (site name, currency, WhatsApp, uploads, SEO...)
# are managed in Admin > Settings, not here.
#--------------------------------------------------------------------------

APP_NAME="KN Bazar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Use your real domain in production, e.g. https://www.example.com
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Business/security events (payments, approvals, downloads) -> storage/logs/marketplace-*.log
LOG_MARKETPLACE_LEVEL=info
LOG_MARKETPLACE_DAYS=30

#--------------------------------------------------------------------------
# Database (MySQL 8+ / MariaDB 10.4+)
#--------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=knbazar
DB_USERNAME=root
DB_PASSWORD=

#--------------------------------------------------------------------------
# Sessions, cache & queue
#--------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production when the site is served over HTTPS
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# "sync" sends notifications immediately (no worker needed).
# Use "database" + a queue worker for high traffic (see README).
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

# Use MySQL FULLTEXT relevance ordering for search (ignored on SQLite)
MARKETPLACE_FULLTEXT_SEARCH=true

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#--------------------------------------------------------------------------
# Mail (optional) - used for password resets, email verification and
# notification emails (enable in Admin > Settings > Notifications).
# "log" writes emails to storage/logs/laravel.log instead of sending them.
#--------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
